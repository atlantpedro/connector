{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may call",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-overview",
    "allow-messages",
    "allow-mark-seen",
    "allow-finish-session",
    "allow-set-aside",
    "allow-open-kept",
    "allow-show-kept",
    "allow-open-folder",
    "allow-open-log-folder",
    "allow-settings",
    "allow-set-editor",
    "allow-set-language",
    "allow-set-tray",
    "allow-set-prompts",
    "allow-set-autostart",
    "allow-set-updates",
    "allow-check-update",
    "allow-install-update"
  ]
}
